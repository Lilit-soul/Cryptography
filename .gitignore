# === Файлы с паролями и конфигурацией ===
.encrypt_config          # мастер-пароль программы

# === Логи ===
encrypt.log              # журнал действий

# === Зашифрованные файлы (опционально) ===
*.enc                    # все зашифрованные файлы
decr_*                   # расшифрованные проверочные файлы

# === Скомпилированные файлы ===
encrypt_fw               # готовый исполняемый файл
*.o                      # объектные файлы
*.d                      # файлы зависимостей
